# Stripe — secret key for Checkout Session creation (server-side only)
# Test mode: sk_test_..., Live mode: sk_live_...
STRIPE_SECRET_KEY=

# Stripe webhook — signing secret of the endpoint <origin>/api/stripe/webhook
# (Stripe dashboard → Developers → Webhooks; events: checkout.session.completed,
# checkout.session.async_payment_succeeded). Without it the endpoint answers 503.
# Local testing: `stripe listen --forward-to localhost:3100/api/stripe/webhook`
# prints a whsec_... for this variable. Needs RESEND_API_KEY below to email orders.
STRIPE_WEBHOOK_SECRET=

# Stripe optional features — off unless set to 1. Turn on only AFTER the matching
# dashboard setup exists; see docs/STRIPE.md and src/lib/server/stripe-options.ts.
# Stripe Tax: breaks Checkout if switched on before Stripe Tax is configured.
STRIPE_AUTOMATIC_TAX=
# Post-purchase invoice PDFs (Stripe may charge per paid invoice).
STRIPE_INVOICE_CREATION=

# Resend — sends the /contact form and the webhook's new-order notices (server-side only). Sign up at
# resend.com, create an API key, and verify august.tf as a sending domain
# there (adds a few DNS records) so mail can go out "from" hi@august.tf to
# any recipient. Without domain verification, Resend restricts sending to
# only the address the Resend account itself was created with — fine for
# an initial smoke test, not for real enquiries from the public site.
# Without this key at all, /contact's action fails clearly (500, does not
# pretend to have sent anything) in production, and logs the message to
# the console instead of sending it in local dev — see
# src/routes/contact/+page.server.ts.
RESEND_API_KEY=
